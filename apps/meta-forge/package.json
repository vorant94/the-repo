{
  "name": "meta-forge",
  "version": "0.0.1",
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@hono/swagger-ui": "^0.6.1",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "hono": "^4.12.31",
    "hono-openapi": "^1.3.1",
    "papaparse": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "catalog:",
    "@types/papaparse": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "deploy:production": "wrangler deploy",
    "start:dev": "vite",
    "ts:check": "pnpm run ts:codegen && tsc",
    "ts:codegen": "pnpm run cf-typegen"
  },
  "type": "module"
}
