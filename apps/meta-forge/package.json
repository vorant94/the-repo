{
  "name": "meta-forge",
  "version": "0.0.1",
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@hono/standard-validator": "^0.2.3",
    "@scalar/hono-api-reference": "^0.12.1",
    "aws4fetch": "^1.0.20",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "hono": "^4.12.31",
    "hono-openapi": "^1.3.1",
    "papaparse": "^5.5.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@total-typescript/ts-reset": "catalog:",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "deploy:production": "wrangler deploy",
    "jwt:generate": "node --experimental-strip-types ./scripts/generate-jwt.ts",
    "start:dev": "vite",
    "ts:check": "pnpm run ts:codegen && tsc",
    "ts:codegen": "pnpm run cf-typegen"
  },
  "type": "module"
}
